# Copy this file to .env and choose a non-default local password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password
GRAFANA_PORT=3000

# Optional. scripts/grafana.sh discovers the kind control-plane IP when these
# values are omitted. Define explicit URLs for a remote or non-kind cluster.
# AIOPSLAB_APP_PROMETHEUS_URL=http://192.0.2.10:32001
# AIOPSLAB_INFRA_PROMETHEUS_URL=http://192.0.2.10:32000
# AIOPSLAB_OPENSEARCH_URL=http://192.0.2.10:32200
# AIOPSLAB_JAEGER_URL=http://192.0.2.10:30080/jaeger/ui

# ClickHouse se descubre por la red Docker del ETL. Deben coincidir con
# Keep these values aligned with deploy/etl/.env when changing local credentials.
AIOPSLAB_CLICKHOUSE_HOST=clickhouse
AIOPSLAB_CLICKHOUSE_USER=aiopslab
AIOPSLAB_CLICKHOUSE_PASSWORD=aiopslab-local

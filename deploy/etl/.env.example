# Pinned versions for reproducible experiments.
KAFKA_VERSION=4.2.0
FLINK_VERSION=1.20.1-scala_2.12-java17
CLICKHOUSE_VERSION=25.3.8.23-alpine
MINIO_VERSION=2025.4.22-debian-12-r1
MC_VERSION=2025.4.16-debian-12-r0

# Intended only for the controlled local environment. Change these values on shared hosts.
CLICKHOUSE_USER=aiopslab
CLICKHOUSE_PASSWORD=aiopslab-local
# Keep JDBC heap bounded when Gold rows contain high-cardinality JSON maps.
CLICKHOUSE_BATCH_SIZE=20
MINIO_ROOT_USER=aiopslab
MINIO_ROOT_PASSWORD=aiopslab-local-secret

# scripts/etl.sh calculates this address when deploying kind. It can be overridden.
AIOPSLAB_KAFKA_EXTERNAL_HOST=127.0.0.1

# Default identity for telemetry outside a controlled run.
AIOPSLAB_RUN_ID=unassigned
AIOPSLAB_SCENARIO_ID=unassigned
